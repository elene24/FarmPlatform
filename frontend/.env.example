# Base URL of the API. Leave empty in development (Vite proxies /api to the backend).
# Production example: https://api.example.ge
VITE_API_BASE_URL=

# Google Maps JavaScript API key (browser key restricted by HTTP referrer to your domains).
# Enable these APIs for the key: Maps JavaScript API, Places API (New), Geocoding API.
# Without a key, location fields fall back to "use my current location" + manual coordinates.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID (Google Cloud > Map Management). Optional in development: DEMO_MAP_ID is used when empty.
VITE_GOOGLE_MAPS_MAP_ID=
